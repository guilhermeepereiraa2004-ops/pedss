# Opcional: domínio base para identificar lojas por subdomínio após configurar DNS.
# As rotas /store/slug funcionam sem esta variável.
VITE_PUBLIC_DOMAIN=

# Opcional: origem já publicada para o QR code (ex.: https://cardapio.exemplo.com).
# Não publica o projeto nem sincroniza o catálogo local entre dispositivos.
VITE_PUBLIC_MENU_ORIGIN=

# local: preserva a demonstração no navegador. remote: API + PostgreSQL.
VITE_RUNTIME_MODE=local
# Acesso local ao banco remoto exige opt-in explícito; não definir para testes/demonstrações.
PEDSS_ALLOW_REMOTE_DATABASE=false
# Somente servidor. PostgreSQL (Neon ou Supabase); nunca usar prefixo VITE_.
# Supabase: Transaction pooler na API e conexão direta/Session pooler na manutenção.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# CA oficial do projeto, quando exigida. PEM, com quebras reais ou escapadas como \n.
# A validação TLS permanece obrigatória. Não usar rejectUnauthorized=false.
DATABASE_SSL_CA=
# Somente manutenção: identifica o projeto destino, sem senha.
SUPABASE_PROJECT_REF=
# Código aleatório privado para criar a primeira conta. Não publicar seu valor.
PEDSS_SETUP_TOKEN=
# Somente servidor. Chave Standard do openrouteservice para rotas pelas ruas.
# Nunca usar VITE_ nem colocar a chave no painel ou navegador.
OPENROUTESERVICE_API_KEY=
# Opcional: chave privada para assinar cotações de frete; por padrão deriva do segredo DATABASE_URL.
PEDSS_QUOTE_SECRET=
