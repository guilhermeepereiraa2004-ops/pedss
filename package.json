{
  "name": "pedss",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.mjs",
    "db:transfer": "node --env-file-if-exists=.env.local scripts/db-transfer.mjs",
    "build": "node scripts/build-server.mjs && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:layers": "node scripts/check-layers.mjs",
    "check": "node scripts/gate.mjs",
    "format": "prettier --write src scripts tests index.html vite.config.js vitest.config.mjs eslint.config.js package.json tsconfig.json docs README.md"
  },
  "dependencies": {
    "@google/model-viewer": "4.4.0",
    "@vercel/functions": "^3.10.2",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.7.0",
    "onnxruntime-web": "1.24.3",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.14.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.7",
    "@electric-sql/pglite": "^0.5.12",
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.0.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
